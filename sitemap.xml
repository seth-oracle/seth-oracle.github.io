---
layout: null
---
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/guides/' | absolute_url }}</loc></url>
  <url><loc>{{ '/assistant/' | absolute_url }}</loc></url>
  <url><loc>{{ '/reviews/' | absolute_url }}</loc></url>
  {% assign published_tutorials = site.tutorials | where: "published", true %}
  {% for doc in published_tutorials %}
  <url><loc>{{ doc.url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% for doc in site.feature_docs %}
  <url><loc>{{ doc.url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% comment %}Include standalone feature tutorial pages.{% endcomment %}
  {% for p in site.pages %}
    {% if p.url contains '/features/' and p.url != '/features/' and p.url != '/features/index.html' %}
  <url><loc>{{ p.url | absolute_url | xml_escape }}</loc></url>
    {% endif %}
  {% endfor %}
</urlset>
